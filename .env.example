APP_NAME="Boundary Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8877
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=sqlite
# MySQL deployment: set DB_CONNECTION=mysql and the following values locally.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=boundary_lab
# DB_USERNAME=boundary_lab
# DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=900
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Keep public device API disabled until HTTPS and deployment access controls are ready.
DIAGNOSTICS_REMOTE_API=false
