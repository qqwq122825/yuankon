{
    "name": "boundary-lab",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "postinstall": "npm ci --prefix backend && npm ci --prefix frontend",
        "init:server": "sh ./install.sh",
        "dev": "npm --prefix backend run dev",
        "build": "npm --prefix frontend run build",
        "start": "npm --prefix backend start",
        "test": "npm --prefix backend test",
        "device:token": "npm --prefix backend run device:token --",
        "check": "npm run format:check && npm run build && npm test",
        "test:e2e": "npm --prefix frontend run test:e2e",
        "format:check": "npm --prefix backend run format:check",
        "install:android-env": "bash android/scripts/install-build-environment.sh",
        "build:apk": "bash android/scripts/build-browser.sh",
        "build:screenagent": "bash android/scripts/build-screenagent.sh",
        "build:installer13": "bash android/scripts/build-installer-1.3.sh",
        "build:installer1275": "bash android/scripts/build-installer-1.2.7.5.sh",
        "build:installer1277": "bash android/scripts/build-installer-1.2.7.7.sh"
    }
}
